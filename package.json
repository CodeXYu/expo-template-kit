{
  "name": "expo-template-kit-demo",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/ui": "~58.0.23",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@sentry/react-native": "~8.28.0",
    "@shopify/flash-list": "2.3.2",
    "@tanstack/react-query": "^5.101.0",
    "dayjs": "^1.11.21",
    "expo": "~58.0.19",
    "expo-constants": "~58.0.13",
    "expo-dev-client": "~58.0.15",
    "expo-device": "~58.0.5",
    "expo-font": "~58.0.10",
    "expo-glass-effect": "~58.0.5",
    "expo-image": "~58.0.17",
    "expo-linking": "~58.0.14",
    "expo-localization": "~58.0.5",
    "expo-network": "~58.0.4",
    "expo-router": "~58.0.26",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "expo-template-kit": "*",
    "expo-web-browser": "~58.0.6",
    "i18next": "^26.3.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "^17.0.8",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-keyboard-controller": "1.22.7",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-splash-screen-newarch": "2.2.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0",
    "reactotron-react-native": "^5.3.1",
    "rn-backstage": "1.5.4",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3",
    "eslint": "^9.0.0",
    "prettier": "^3.9.6",
    "dotenv-cli": "^11.0.0",
    "eslint-config-expo": "~58.0.0"
  },
  "scripts": {
    "start": "npm run start:dev",
    "android": "npm run android:dev",
    "ios": "npm run ios:dev",
    "web": "expo start --web",
    "lint": "eslint src packages/kit/src packages/kit/scripts packages/kit/template packages/kit/test scripts",
    "typecheck": "tsc --noEmit --pretty false",
    "test": "npm run test --workspace expo-template-kit",
    "verify:boundaries": "npm run verify:boundaries --workspace expo-template-kit",
    "verify:matrix": "npm run verify:matrix --workspace expo-template-kit",
    "pack:check": "npm run pack:check --workspace expo-template-kit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "start:dev": "dotenv -o -e .env.development -- expo start",
    "start:int": "dotenv -o -e .env.int -- expo start",
    "android:dev": "dotenv -o -e .env.development -- expo run:android",
    "android:int": "dotenv -o -e .env.int -- expo run:android --variant release",
    "android:production": "dotenv -o -e .env.production -- expo run:android --variant release",
    "ios:dev": "dotenv -o -e .env.development -- expo run:ios",
    "ios:int": "dotenv -o -e .env.int -- expo run:ios --configuration Release",
    "ios:production": "dotenv -o -e .env.production -- expo run:ios --configuration Release",
    "postinstall": "node scripts/setup-env.mjs && node packages/kit/scripts/patch-native-deps.mjs"
  },
  "private": true,
  "workspaces": [
    "packages/*"
  ]
}
