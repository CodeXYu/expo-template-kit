# Environment variable, should be development / int / production
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_API_BASE_URL=

# Explicit true/false values override the development default.
EXPO_PUBLIC_ENABLE_BACKSTAGE=false
EXPO_PUBLIC_ENABLE_LOGGER=false

# Required for Reactotron in an INT Release build. Use the computer's LAN IP.
EXPO_PUBLIC_REACTOTRON_HOST=

# Sentry DSN is a public ingest identifier. Leave empty to disable reporting.
EXPO_PUBLIC_SENTRY_DSN=
# Optional; defaults to EXPO_PUBLIC_APP_ENV.
EXPO_PUBLIC_SENTRY_ENVIRONMENT=
# 0 disables performance tracing. Development defaults to 1, other envs to 0.
EXPO_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=
